# GHIS HR — https://greenheights.edu.eg/hr
# Installed as /home/tarek/conf/web/greenheights.edu.eg/nginx.ssl.conf_hr (included by Hestia inside the SSL server block).
# "^~" so Hestia's regex location for static files never takes over /hr/.
location = /hr { return 301 /hr/; }

location ^~ /hr/ {
    # Only public/hr/assets/* exists under this root, so no PHP or config file can ever be served as a file.
    root /home/tarek/web/greenheights.edu.eg/hr-system/public;
    client_max_body_size 8m;
    # Keep request bodies (face-camera frames) in memory so nginx never spools them to a temp file.
    client_body_buffer_size 8m;

    location ^~ /hr/assets/ {
        try_files $uri @gh_hr;
        expires 30d;
        add_header Cache-Control "public" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    try_files $uri @gh_hr;
}

location @gh_hr {
    client_max_body_size 8m;
    client_body_buffer_size 8m;
    include /etc/nginx/fastcgi_params;
    fastcgi_param SCRIPT_FILENAME /home/tarek/web/greenheights.edu.eg/hr-system/public/index.php;
    fastcgi_param SCRIPT_NAME     /hr/index.php;
    fastcgi_param DOCUMENT_ROOT   /home/tarek/web/greenheights.edu.eg/hr-system/public;
    fastcgi_param HTTPS on;  # Debian's fastcgi_params also sets this from $https inside the SSL block
    fastcgi_param HTTP_PROXY "";
    fastcgi_hide_header X-Powered-By;
    fastcgi_read_timeout 120s;
    fastcgi_pass unix:/run/php/php8.3-fpm-gh-hr.sock;
}
